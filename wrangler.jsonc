// One script, two Workers (see worker/index.ts):
//   npx wrangler deploy              -> portfolio        (public site, kshitijbhardwaj.space)
//   npx wrangler deploy --env admin  -> portfolio-admin  (behind Cloudflare Access, admin.kshitijbhardwaj.space)
{
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "kshitijbhardwaj.space", "custom_domain": true },
    { "pattern": "ironman.kshitijbhardwaj.space", "custom_domain": true } // react-iron-man docs: / serves /iron-man
  ],
  "workers_dev": false, // the domains are the only addresses
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Images, and keeping /admin and /api off the public site.
    "run_worker_first": ["/", "/api/*", "/media/*", "/admin", "/admin/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portfolio-media" }],
  "vars": { "GITHUB_REPO": "KshitijBhardwaj18/portfolio", "GITHUB_BRANCH": "main" },
  // Secret on portfolio only, set with: npx wrangler secret put GITHUB_TOKEN

  "env": {
    "admin": {
      "name": "portfolio-admin",
      "routes": [{ "pattern": "admin.kshitijbhardwaj.space", "custom_domain": true }], // its root redirects to /admin
      "workers_dev": false,
      "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": true // every request gets the Access check
      },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "portfolio-media" }],
      "services": [{ "binding": "SITE", "service": "portfolio", "entrypoint": "AdminApi" }],
      "vars": {
        "GITHUB_REPO": "KshitijBhardwaj18/portfolio",
        "GITHUB_BRANCH": "main",
        "ACCESS_TEAM_DOMAIN": "https://young-fire-f72a.cloudflareaccess.com",
        "ACCESS_AUD": "258d9c5b569644804021a9ef18732f790aecccffc4e86c88fee92a32f47dc59f" // the Access application's audience tag
      }
    }
  }
}
